# ---------------------------------------------------------------------------
# Virto Commerce local stack - configuration template.
# Copy to .env (or run scripts/generate-env.sh, which fills the secrets with
# random values). NEVER commit .env. All values below are placeholders.
# ---------------------------------------------------------------------------

# --- Image references (pin these; see scripts/pin-images.sh and docs/ARCHITECTURE.md)
# Platform version MUST match the module bundle's PlatformVersion (3.1076.13 for bundle "latest").
# Docker Hub :latest is a newer platform than the stable bundle, so we use the official ghcr.io tag.
PLATFORM_IMAGE=ghcr.io/virtocommerce/platform:3.1076.13
MODULES_BUNDLE_URL=https://raw.githubusercontent.com/VirtoCommerce/vc-modules/refs/heads/master/bundles/latest/package.json
# Optional: GitHub token for vc-build (avoids 'API rate limit exceeded' on shared IPs; no scopes needed). Do not commit a real one.
# GITHUB_TOKEN=
DOTNET_SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0   # vc-build (VirtoCommerce.GlobalTool) targets net10.0
# Current storefront = vc-frontend served by nginx (artifact version comes from the module bundle).
FRONTEND_IMAGE=nginx:1.30.7-alpine
# LEGACY official storefront image - kept only as documented incompatibility evidence (profile "legacy").
STOREFRONT_IMAGE=virtocommerce/storefront:latest
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.15.3
REDIS_IMAGE=redis:7.4-alpine

# --- Host ports (bound to 127.0.0.1 only)
PLATFORM_HOST_PORT=8090
STOREFRONT_HOST_PORT=8080

# --- Database (SQL Server). Password must satisfy SQL Server complexity rules.
MSSQL_SA_PASSWORD=CHANGE_ME_generate_with_scripts_generate-env.sh
VC_DB_NAME=VirtoCommerce3

# --- Redis
REDIS_PASSWORD=CHANGE_ME_generate_with_scripts_generate-env.sh

# --- Search
SEARCH_PROVIDER=ElasticSearch8   # must match the module id (VirtoCommerce.ElasticSearch8)
SEARCH_SCOPE=default

# --- LEGACY storefront only (compose profile "legacy", known-incompatible - see docs/TROUBLESHOOTING.md).
# vc-frontend (the default storefront) needs none of these.
PLATFORM_INTERNAL_URL=http://platform
STOREFRONT_API_USER=frontend
STOREFRONT_API_PASSWORD=CHANGE_ME_set_after_creating_the_user_in_platform_admin

# --- Container runtime
TZ=UTC
