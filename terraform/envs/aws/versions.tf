terraform {
  required_version = ">= 1.6.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.80"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
  # Real deployments must use remote state (S3 + DynamoDB lock) - configure via -backend-config.
  backend "s3" {}
}
